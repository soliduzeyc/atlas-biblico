---
import '../styles/tokens.css';
import 'leaflet/dist/leaflet.css';

interface Props {
  geojsonUrl: string;
}

const { geojsonUrl } = Astro.props;
---

<div class="tribes-app" data-geojson-url={geojsonUrl}>
  <div class="tribes-map" data-role="map"></div>
  <p class="tribes-caption" data-role="caption"></p>
</div>

<style is:global>
  .tribes-app { display: flex; flex-direction: column; gap: 10px; }
  .tribes-map {
    height: 62vh; min-height: 420px; border: 1px solid var(--line);
    background: var(--paper-2);
  }
  .tribes-caption {
    font-family: var(--f-mono); font-size: 10.5px; line-height: 1.5;
    color: var(--ink-2); max-width: 68ch;
  }

  .tribe-label {
    background: transparent !important; border: none !important; box-shadow: none !important;
    font-family: var(--f-disp); font-size: 14px; color: var(--iron);
    text-shadow: 0 1px 3px var(--paper), 0 -1px 3px var(--paper), 1px 0 3px var(--paper), -1px 0 3px var(--paper);
    pointer-events: none;
  }
  .tribe-label::before { display: none; }
  .tribe-label-juda { font-size: 17px; font-weight: 400; }

  .tribes-app .leaflet-popup-content-wrapper {
    border-radius: 2px; background: var(--paper); box-shadow: 0 2px 14px rgba(35, 42, 40, .22); border: 1px solid var(--line);
  }
  .tribes-app .tribe-pop { font-family: var(--f-body); font-size: 13px; line-height: 1.5; }
  .tribes-app .tribe-pop a { color: var(--olive); }
</style>

<script>
  import { initTribesMap } from '../lib/tribes-overview-engine.js';

  document.querySelectorAll('.tribes-app').forEach((root) => {
    initTribesMap(root as HTMLElement);
  });
</script>
