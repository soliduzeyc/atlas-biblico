---
import '../styles/tokens.css';
import 'leaflet/dist/leaflet.css';

interface Props {
  geojsonUrl: string;
  title: string;
}

const { geojsonUrl, title } = Astro.props;
---

<div class="atlas-app" data-geojson-url={geojsonUrl}>
  <header class="hdr">
    <h1>{title}</h1>
    <span class="sub" data-role="subtitle"></span>
    <div class="tally" data-role="tally"></div>
    <div class="search">
      <input
        type="search"
        class="search-input"
        data-role="search"
        placeholder="Buscar lugar, alias o versículo…"
        aria-label="Buscar un lugar por nombre, alias, sitio moderno o versículo"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <button type="button" class="search-clear" data-role="search-clear" aria-label="Limpiar búsqueda" hidden>×</button>
    </div>
  </header>
  <div class="shell">
    <aside class="rail" data-role="rail"></aside>
    <button type="button" class="rail-toggle" data-role="rail-toggle" aria-expanded="true">
      <span data-role="rail-toggle-label">Ocultar la lista ▴</span>
    </button>
    <div class="atlas-map" data-role="map"></div>
  </div>
</div>

<style is:global>
  .atlas-app { display: flex; flex-direction: column; height: 100%; }

  .atlas-app .hdr {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    padding: 12px 18px; border-bottom: 1px solid var(--line); background: var(--paper);
  }
  .atlas-app .hdr h1 { font-family: var(--f-disp); font-size: 26px; font-weight: 400; letter-spacing: .01em; line-height: 1; }
  .atlas-app .hdr .sub { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .atlas-app .tally { margin-left: auto; display: flex; gap: 12px; font-family: var(--f-mono); font-size: 11px; color: var(--ink-2); }
  .atlas-app .tally b { color: var(--iron); font-weight: 500; }

  /* El buscador vive en la cabecera para seguir accesible con el panel plegado. */
  .atlas-app .search { position: relative; display: flex; align-items: center; }
  .atlas-app .search-input {
    width: 230px;
    padding: 6px 26px 6px 10px;
    font-family: var(--f-body);
    font-size: 13px;
    color: var(--iron);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 2px;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .atlas-app .search-input::placeholder { color: var(--ash); }
  .atlas-app .search-input:focus { border-color: var(--olive); background: var(--paper); }
  .atlas-app .search-input::-webkit-search-cancel-button { display: none; }
  .atlas-app .search-clear {
    position: absolute; right: 4px;
    width: 20px; height: 20px; padding: 0;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    color: var(--ash); font-size: 17px; line-height: 1;
  }
  .atlas-app .search-clear:hover { color: var(--iron); }

  /* Cabecera del modo resultados y explicación de por qué coincidió. */
  .atlas-app .res-hdr {
    padding: 11px 16px 4px;
    font-family: var(--f-mono); font-size: 10px; letter-spacing: .13em;
    text-transform: uppercase; color: var(--ink-2);
  }
  .atlas-app .row .motivo {
    display: block; font-size: 11px; color: var(--olive);
    margin-top: 2px; font-style: italic;
  }
  .atlas-app .row.sel { background: var(--paper-2); border-left-color: var(--olive); }
  .atlas-app .row .alt-flag {
    display: inline-block; margin-top: 3px;
    font-family: var(--f-mono); font-size: 9.5px; letter-spacing: .06em;
    text-transform: uppercase; color: var(--sea);
    border: 1px solid var(--sea); padding: 1px 5px;
  }
  .atlas-app .no-res {
    padding: 18px 16px; font-size: 13px; color: var(--ink-2); line-height: 1.5;
  }
  .atlas-app .no-res b { color: var(--iron); font-weight: 500; }

  .atlas-app .shell { flex: 1; display: flex; min-height: 0; }
  .atlas-app .atlas-map { flex: 1; min-height: 0; background: var(--paper-2); }

  /* Solo en móvil: pliega el panel entero para dejar el mapa a pantalla completa. */
  .atlas-app .rail-toggle { display: none; }

  .atlas-app .rail {
    width: 326px; flex-shrink: 0; overflow-y: auto; border-right: 1px solid var(--line);
    background: var(--paper); -webkit-overflow-scrolling: touch;
  }
  .atlas-app .ctrls { padding: 10px 16px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 7px; }
  .atlas-app .ctrls label { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--ink-2); cursor: pointer; }
  .atlas-app .ctrls input { accent-color: var(--olive); width: 14px; height: 14px; cursor: pointer; }

  /* Plegables: en escritorio van siempre abiertos y sin cabecera visible;
     en móvil el <summary> es el control para abrirlos. */
  .atlas-app .fold > summary {
    display: none;
    list-style: none;
    cursor: pointer;
    padding: 11px 16px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line);
  }
  .atlas-app .fold > summary::-webkit-details-marker { display: none; }
  .atlas-app .fold > summary::after { content: " ▾"; color: var(--ash); }
  .atlas-app .fold[open] > summary::after { content: " ▴"; }

  .atlas-app .segmento {
    padding: 16px 16px 2px; font-family: var(--f-disp); font-size: 15px;
    color: var(--iron); border-top: 2px solid var(--iron); margin-top: 6px;
  }
  .atlas-app .segmento:first-of-type { border-top: none; margin-top: 0; }

  .atlas-app .tramo {
    padding: 14px 16px 5px; font-family: var(--f-mono); font-size: 10px; letter-spacing: .13em;
    text-transform: uppercase; color: var(--ink-2); border-top: 1px solid var(--line); margin-top: 2px;
  }
  .atlas-app .segmento + .tramo { border-top: none; }

  .atlas-app .row {
    display: grid; grid-template-columns: 26px 20px 1fr; gap: 8px; align-items: baseline;
    padding: 6px 16px; cursor: pointer; border-left: 2px solid transparent;
  }
  .atlas-app .row:hover { background: var(--paper-2); }
  .atlas-app .row.on { background: var(--paper-2); border-left-color: var(--iron); }
  .atlas-app .row .n { font-family: var(--f-mono); font-size: 10px; color: var(--ash); }
  .atlas-app .row .sg { font-size: 13px; line-height: 1.2; }
  .atlas-app .row .nm { font-size: 14px; line-height: 1.3; }
  .atlas-app .row .id { display: block; font-size: 11.5px; color: var(--ink-2); margin-top: 1px; }
  .atlas-app .row.dim { opacity: .45; }

  .atlas-app .c-alta { color: var(--olive); }
  .atlas-app .c-media { color: var(--ochre); }
  .atlas-app .c-baja { color: var(--ash); }

  .atlas-app .leg { padding: 14px 16px 26px; border-top: 1px solid var(--line); margin-top: 10px; }
  .atlas-app .leg h2 {
    font-family: var(--f-mono); font-size: 10px; letter-spacing: .13em; text-transform: uppercase;
    color: var(--ink-2); font-weight: 500; margin-bottom: 8px;
  }
  .atlas-app .leg dl { display: grid; grid-template-columns: 22px 1fr; gap: 4px 8px; font-size: 12px; color: var(--ink-2); margin-bottom: 12px; }
  .atlas-app .leg dt { text-align: center; }
  .atlas-app .leg .swatch { display: inline-block; width: 22px; height: 3px; vertical-align: middle; }

  .atlas-app .leaflet-popup-content-wrapper {
    border-radius: 2px; background: var(--paper); box-shadow: 0 2px 14px rgba(35, 42, 40, .22); border: 1px solid var(--line);
  }
  .atlas-app .leaflet-popup-content { margin: 12px 14px; width: 262px !important; font-family: var(--f-body); font-size: 13px; line-height: 1.45; }
  .atlas-app .leaflet-popup-tip { background: var(--paper); border: 1px solid var(--line); }
  .atlas-app .zone-tip {
    background: var(--iron); color: var(--paper); border: none; font-family: var(--f-mono);
    font-size: 10.5px; padding: 3px 7px; border-radius: 1px;
  }
  .atlas-app .zone-tip::before { border-top-color: var(--iron); }
  .atlas-app .pop h3 { font-family: var(--f-disp); font-weight: 400; font-size: 20px; line-height: 1.1; margin-bottom: 2px; }
  .atlas-app .pop .ident { font-size: 12.5px; color: var(--ink-2); margin-bottom: 9px; }
  .atlas-app .pop .tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 9px; }
  .atlas-app .pop .tag {
    font-family: var(--f-mono); font-size: 9.5px; letter-spacing: .07em; text-transform: uppercase;
    padding: 2px 6px; border: 1px solid var(--line); color: var(--ink-2);
  }
  .atlas-app .pop .tag.hi { border-color: var(--olive); color: var(--olive); }
  .atlas-app .pop .tag.md { border-color: var(--ochre); color: var(--ochre); }
  .atlas-app .pop dl.meta { display: grid; grid-template-columns: auto 1fr; gap: 3px 9px; font-size: 11.5px; margin-bottom: 9px; }
  .atlas-app .pop dl.meta dt { font-family: var(--f-mono); font-size: 9.5px; letter-spacing: .07em; text-transform: uppercase; color: var(--ash); padding-top: 1px; }
  .atlas-app .pop .note { font-size: 12px; color: var(--ink-2); border-top: 1px solid var(--line); padding-top: 8px; line-height: 1.45; }
  .atlas-app .pop .warn {
    font-size: 12px; background: var(--paper-2); border-left: 2px solid var(--ochre);
    padding: 7px 9px; margin-top: 8px; line-height: 1.4;
  }
  .atlas-app .pop .alias { font-family: var(--f-mono); font-size: 10.5px; color: var(--ash); margin-top: 7px; line-height: 1.5; }

  .atlas-app .wrap { position: relative; display: flex; align-items: center; justify-content: center; }
  .atlas-app .mk { display: block; border-radius: 50%; }
  .atlas-app .dan { position: absolute; top: 0; left: 0; border-radius: 50%; pointer-events: none; }
  .atlas-app .pop .tag.dan { border-color: var(--sea); color: var(--sea); }
  .atlas-app .pop .dan-note {
    font-size: 12px; background: var(--paper-2); border-left: 2px solid var(--sea);
    padding: 7px 9px; margin-top: 8px; line-height: 1.45;
  }
  .atlas-app .halo { border-radius: 50%; pointer-events: none; }

  @media (max-width: 820px) {
    .atlas-app .shell { flex-direction: column-reverse; }
    /* El mapa toma el espacio sobrante y el panel una fracción acotada. Antes
       eran 56vh + 44vh, que sumado a la cabecera desbordaba la pantalla y
       empujaba el título fuera de vista. */
    .atlas-app .rail {
      width: 100%; border-right: none; border-bottom: 1px solid var(--line);
      flex: 0 0 auto; max-height: 45%;
    }
    .atlas-app .atlas-map { flex: 1 1 auto; min-height: 0; }

    .atlas-app .fold > summary { display: block; }
    .atlas-app .fold[open] > summary { border-bottom-color: var(--line); }

    .atlas-app .rail-toggle {
      display: block;
      flex: 0 0 auto;
      width: 100%;
      padding: 11px 14px;
      background: var(--paper);
      color: var(--ink-2);
      border: none;
      border-top: 1px solid var(--line);
      font-family: var(--f-mono);
      font-size: 10px;
      letter-spacing: .13em;
      text-transform: uppercase;
      text-align: left;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .atlas-app .rail-toggle:active { background: var(--paper-2); }
    .atlas-app.rail-hidden .rail { display: none; }

    .atlas-app .hdr { padding: 8px 14px; gap: 8px; }
    .atlas-app .hdr h1 { font-size: 20px; }
    .atlas-app .hdr .sub { display: none; }
    .atlas-app .tally { width: 100%; margin-left: 0; order: 3; gap: 9px; font-size: 10px; }
    .atlas-app .search { width: 100%; order: 4; margin-top: 2px; }
    .atlas-app .search-input {
      width: 100%;
      /* 16 px evita que iOS haga zoom automático al enfocar el campo. */
      font-size: 16px;
      padding: 7px 28px 7px 10px;
    }

    /* Filas más compactas: en un 12 mini cada píxel vertical cuenta. */
    .atlas-app .segmento { padding: 12px 14px 2px; font-size: 14px; }
    .atlas-app .tramo { padding: 10px 14px 4px; }
    .atlas-app .row { padding: 5px 14px; }
    .atlas-app .row .nm { font-size: 13.5px; }
    .atlas-app .row .id { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-app * { transition: none !important; animation: none !important; }
  }
</style>

<script>
  import { initAtlasMap } from '../lib/map-engine.js';

  document.querySelectorAll('.atlas-app').forEach((root) => {
    initAtlasMap(root as HTMLElement);
  });
</script>
